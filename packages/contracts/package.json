{
  "name": "@cerbo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared request/response TypeScript types. One file per module, owned by that module's task.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
