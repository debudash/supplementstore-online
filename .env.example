# Copy to .env for local development.
# Local Postgres (matches docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cerbo

# API port. Railway provides PORT in production.
PORT=3000

# development | production
NODE_ENV=development

# Enables demo-only endpoints (restock, baseline, migration, reset).
DEMO_MODE=true

# Set to "true" if the Postgres connection requires SSL (e.g. some managed hosts).
PGSSL=false
